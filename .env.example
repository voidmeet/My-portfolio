# Contact terminal delivery (EmailJS — https://www.emailjs.com).
# Template params sent: from_name, from_email, message, to_email.
# When these are unset the terminal falls back to opening a pre-filled mailto: link.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
